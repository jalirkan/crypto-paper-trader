# /etc/cpt/tipjar.env — environment for cpt-tipjar.service
LN_NETWORK=signet
LND_REST_URL=https://127.0.0.1:8080
LND_TLS_CERT=/etc/cpt/lnd-tls.cert
# Baked, invoice-only macaroon (NOT admin.macaroon — see README step 4):
LND_MACAROON=/etc/cpt/invoice.macaroon
LN_USERNAME=tips
LN_DOMAIN=example.com
TIP_PUBLIC_BASE=https://example.com
TIP_MIN_SATS=10
TIP_MAX_SATS=500000
TIP_DB=/opt/crypto-paper-trader/data/tips.db
TIP_PORT=8090
